# The game's OWN server (server/, see docs/DEPLOY_VPS.md). Set this and the game uses it for accounts, saves, chat and the rest.
# https only (http://localhost is allowed while developing). When it is set, the two Supabase values below are ignored.
VITE_API_URL=

# Being retired (see docs/BACKEND_V2_PLAN.md): the old Supabase settings.
# Copy this file to .env and fill in both values to switch the online part on (see docs/BACKEND.md).
# Leave them empty and the game stays fully offline.
# Use the anon / publishable key only. NEVER put the service_role key here.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

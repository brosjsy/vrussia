# V Russia server settings. Copy to /etc/vrussia/server.env on the VPS (chmod 600, owner root) - NEVER commit the real file.
NODE_ENV=production
HOST=127.0.0.1
PORT=8080
PUBLIC_URL=https://api.example.com
APP_URL=https://example.com/
CORS_ORIGINS=https://example.com
TRUST_PROXY=true

# The running server connects as vr_app (rows only). Migrations use MIGRATION_DATABASE_URL as vr_owner (a separate, rarely used secret).
DATABASE_URL=postgres://vr_app:CHANGE_ME@127.0.0.1:5432/vrussia
# 'off' is acceptable ONLY when PostgreSQL is on the same machine and listens on 127.0.0.1 / a Unix socket. Use 'require' over any network.
DATABASE_SSL=off
DATABASE_POOL_MAX=10
# MIGRATION_DATABASE_URL=postgres://vr_owner:CHANGE_ME@127.0.0.1:5432/vrussia

COOKIE_SECURE=true
SESSION_IDLE_DAYS=14
SESSION_MAX_DAYS=60
REQUIRE_VERIFIED_EMAIL=true

# Any SMTP provider (Amazon SES, Postmark, Mailgun, Brevo, your own mail server...).
EMAIL_TRANSPORT=smtp
EMAIL_FROM=V Russia <no-reply@example.com>
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=

# The brand on every e-mail (set BRAND_NAME=LagosLifeApp only if that name is yours).
BRAND_NAME=V Russia
BRAND_COLOR=#2f6fd6
# BRAND_LOGO_URL=https://example.com/logo.png
# BRAND_SUPPORT_EMAIL=support@example.com
BRAND_FOOTER=You get this e-mail because of an account in the game.
# TEMPLATE_DIR=/etc/vrussia/templates

LOG_LEVEL=info
